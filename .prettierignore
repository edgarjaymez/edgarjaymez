# Generated by pnpm — Prettier would reformat 4,205 lines and pnpm would undo it
pnpm-lock.yaml

# Build output / generated types (also covered by .gitignore, stated explicitly here
# so the formatter policy does not depend on git ignore rules)
dist/
.astro/

# Raw Figma exports. These are committed unedited on purpose — everything the page needs is
# applied at build time by src/lib/art/prepare-svg.mjs. Formatting them would churn the diff on
# every re-export and break the promise that redrawing a scene is an export, never a merge.
src/assets/journey/**/*.svg

# Generated by scripts/art-palette.mjs, which verifies them byte-for-byte with --check.
# Formatting them here would make that check permanently unsatisfiable.
src/assets/palette/
