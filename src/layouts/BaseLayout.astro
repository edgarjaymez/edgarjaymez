---
import type { ImageMetadata } from "astro";

import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/shell/Footer.astro";
import Header from "../components/shell/Header.astro";
import SkipLink from "../components/shell/SkipLink.astro";
import { getLang, localeMeta, type RouteDescriptor } from "../i18n/routes";

interface Props {
  title: string;
  description: string;
  /** Which route this page is. Required, so nothing has to infer it from the URL. */
  route: RouteDescriptor;
  image?: ImageMetadata;
  noindex?: boolean;
}

/**
 * There was a `bare` prop here, added in anticipation of the journey "providing its own chrome". The
 * journey landed and does not want it, for two reasons worth recording so it does not come back by
 * reflex:
 *
 * 1. `footer#clearing` is part of the journey's own contract, and a site footer belongs *outside*
 *    `<main>`. A journey that rendered its own would have to put it inside.
 * 2. The header is the only route from the home page to `/resume/` and `/contact/` that is not
 *    inside a scene. Removing it makes the home page a dead end for those two.
 *
 * Suppressing the header visually during the walk is a styling decision, and it belongs to the
 * styled phase — not to a prop that changes what ships in the HTML.
 */
const { title, description, route, image, noindex } = Astro.props;

const lang = getLang(Astro.url);
---

<html lang={localeMeta[lang].htmlLang}>
  <head>
    <BaseHead
      title={title}
      description={description}
      route={route}
      image={image}
      noindex={noindex}
    />
    <slot name="head" />
    <script>
      // Mode A: element definitions are bundled for the client here, never in frontmatter —
      // frontmatter runs on the server and customElements.define would throw.
      import "@edgarjaymez/grove";

      // Grove emits <ph-*> elements but does not register them; the consuming app must. Every icon
      // name used anywhere in this app is imported here, and scripts/check-dist.mjs fails the
      // build if a name is rendered without a matching import — an unimported icon renders nothing
      // at all, silently.
      import "@phosphor-icons/webcomponents/PhBriefcase"; // briefcase — work
      import "@phosphor-icons/webcomponents/PhFlask"; // flask — lab
      import "@phosphor-icons/webcomponents/PhFire"; // fire — blog
      import "@phosphor-icons/webcomponents/PhFileText"; // file-text — resume
      import "@phosphor-icons/webcomponents/PhEnvelope"; // envelope — contact
      import "@phosphor-icons/webcomponents/PhArrowLeft"; // arrow-left — back button
      import "@phosphor-icons/webcomponents/PhInfo"; // info — notices
      import "@phosphor-icons/webcomponents/PhCheckCircle"; // check-circle — notices
      import "@phosphor-icons/webcomponents/PhWarningCircle"; // warning-circle — notices
    </script>
  </head>
  <body>
    <SkipLink />
    <Header route={route} />
    {/* tabindex="-1" so the skip link can move focus here, not just scroll. */}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
