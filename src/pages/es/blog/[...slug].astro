---
/**
 * STOPGAP. This route is replaced by proper per-locale blog routes in the blog branch.
 *
 * Two known faults, kept visible rather than half-fixed here, because fixing them properly means
 * building the real routes:
 *
 * 1. It globs the **whole** `blog` collection, so the English post renders under `/es/blog/`.
 * 2. Its `getStaticPaths` returns a `lang` param, but the file path has no `[lang]` segment — so
 *    `Astro.params.lang` was always `undefined`. That is what printed `undefined` in the build log
 *    and what made the post date format against an undefined locale. The locale now comes from the
 *    entry id, which actually carries it.
 */
import { getCollection, render } from "astro:content";

import { localeMeta, type Locale } from "../../../i18n/routes";
import { reportTranslationParity } from "../../../lib/content";
import BaseLayout from "../../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  // Runs once per build. Moves to the real index pages when they land.
  await reportTranslationParity();

  // Drafts are visible while developing and must never reach a build. This route predates
  // src/lib/content.ts and globs every locale, so the filter is applied here explicitly rather
  // than inherited — the real routes go through getEntries().
  const pages = (await getCollection("blog")).filter(
    (page) => import.meta.env.DEV || !page.data.draft,
  );

  return pages.map((page) => {
    const [, ...slug] = page.id.split("/");
    return { params: { slug: slug.join("/") || undefined }, props: page };
  });
}

const page = Astro.props;
const { slug } = Astro.params;

// The entry id is `<locale>/<basename>`, so the locale is knowable here even though the route
// itself has no locale segment.
const [entryLocale] = page.id.split("/");
const lang = (entryLocale in localeMeta ? entryLocale : "en") as Locale;

const { Content } = await render(page);
---

<BaseLayout
  title={page.data.title}
  description={page.data.title}
  route={{ key: "blog", slugs: { [lang]: slug } }}
>
  <article>
    <h1>{page.data.title}</h1>
    <p>
      <span>{page.data.author}</span>
      <time datetime={page.data.date.toISOString()}>
        {page.data.date.toLocaleDateString(localeMeta[lang].htmlLang)}
      </time>
    </p>
    <Content />
  </article>
</BaseLayout>
