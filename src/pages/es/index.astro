---
import { pathFor } from "../../i18n/routes";
import { useTranslations } from "../../i18n/utils";
import BaseLayout from "../../layouts/BaseLayout.astro";

const lang = "es";
const t = useTranslations(lang);
---

<BaseLayout
  title={t("hero.title")}
  description={t("hero.description")}
  route={{ key: "home" }}
>
  <section>
    <h1>{t("hero.title")}</h1>
    <p>{t("hero.role")}</p>
    <p>{t("hero.description")}</p>
    <a href={pathFor(lang, "contact")}>
      <gv-button
        text={t("hero.cta")}
        variant="filled"
        color="accent"
        size="lg"
      ></gv-button>
    </a>
  </section>
</BaseLayout>
