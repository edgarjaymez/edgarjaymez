---
// Grove's CSS and fonts are imported at module scope, which Vite extracts and is SSR-safe.
// The element definitions are a separate client <script> in BaseLayout (Mode A) — never here,
// because frontmatter runs on the server and customElements.define would throw.
import "@edgarjaymez/grove/fonts/display/Cakra.woff2";
import "@edgarjaymez/grove/fonts/sans-serif/InclusiveSans.woff2";
import "@edgarjaymez/grove/fonts/sans-serif/InclusiveSans-Italic.woff2";
import "@edgarjaymez/grove/grove.css";

import type { ImageMetadata } from "astro";

import FallbackImage from "../assets/fallback_thumbnail.png";
import { SITE_TITLE, SITE_TITLE_ES } from "../consts";
import {
  defaultLocale,
  getLang,
  hreflangAlternatesFor,
  localeMeta,
  type RouteDescriptor,
} from "../i18n/routes";

interface Props {
  title: string;
  description: string;
  route: RouteDescriptor;
  image?: ImageMetadata;
  noindex?: boolean;
}

const {
  title,
  description,
  route,
  image = FallbackImage,
  noindex,
} = Astro.props;

const lang = getLang(Astro.url);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image.src, Astro.url);

/**
 * Only exact pairs get an hreflang. Declaring `hreflang="es"` on a section index while the English
 * page is an article tells search engines the two are equivalent, which they are not.
 *
 * A `noindex` page emits none at all. hreflang is a signal about which indexed page to show to
 * which audience, so on a page asking not to be indexed it is meaningless — and for the 404s
 * actively wrong, since the English one is served as `/404.html` while the registry path is
 * `/404/`, so the pair could never be reciprocal.
 */
const alternates = noindex ? [] : hreflangAlternatesFor(route);

/** x-default points at the default locale's version, per Google's guidance. */
const xDefault = alternates.find((a) => a.lang === defaultLocale);
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="shortcut icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<meta name="apple-mobile-web-app-title" content="edgarjaymez" />
<meta name="theme-color" content="#416943" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="sitemap" href="/sitemap-index.xml" />
<meta name="generator" content={Astro.generator} />

<!--
  Per-locale feed. The previous version advertised a single /rss.xml on every page while no such
  route existed, so every reader that followed it got a 404 — and would have subscribed a Spanish
  reader to English posts had it worked. Each locale now points at its own feed.
-->
<link
  rel="alternate"
  type="application/rss+xml"
  title={lang === "es" ? SITE_TITLE_ES : SITE_TITLE}
  href={
    new URL(
      lang === defaultLocale ? "/rss.xml" : `/${lang}/rss.xml`,
      Astro.site,
    )
  }
/>

<!-- Fonts are imported through Grove at module scope, so no preload tags are needed here. -->

<!-- Canonical + alternates -->
<link rel="canonical" href={canonicalURL} />
{alternates.map((alt) => (
  <link
    rel="alternate"
    hreflang={localeMeta[alt.lang].hreflang}
    href={new URL(alt.href, Astro.site)}
  />
))}
{xDefault && (
  <link
    rel="alternate"
    hreflang="x-default"
    href={new URL(xDefault.href, Astro.site)}
  />
)}

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, follow" />}

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImage} />
<meta property="og:locale" content={localeMeta[lang].ogLocale} />
{alternates
  .filter((alt) => alt.lang !== lang)
  .map((alt) => (
    <meta
      property="og:locale:alternate"
      content={localeMeta[alt.lang].ogLocale}
    />
  ))}

<!--
  Twitter card tags use name=, not property=. They are not Open Graph; the OG namespace happens to
  work in some crawlers, which is why the mistake survives so often.
-->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />
