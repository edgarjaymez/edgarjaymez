---
/**
 * The résumé page.
 *
 * The PDF link appears only when `PUBLIC_RESUME_PDF` is configured. A link to a PDF that does not
 * exist is worse than no link, and whether to publish one at all is the Warden's call.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import ResumeDocument from "../components/resume/ResumeDocument.astro";
import { getResume, getSite } from "../lib/content";
import type { Locale } from "../i18n/routes";
import { useTranslations } from "../i18n/utils";
import { PUBLIC_RESUME_PDF } from "astro:env/client";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const site = await getSite(lang);
const resume = await getResume(lang);

/**
 * Read through `astro:env` rather than `import.meta.env`, so the name is declared in one schema with
 * the contact variables instead of being a string that is either spelled right or silently undefined.
 */
const pdfHref = PUBLIC_RESUME_PDF;
---

<BaseLayout
  title={t("nav.resume")}
  description={site.profile.summary}
  route={{ key: "resume" }}
>
  {resume ? (
    <>
      {pdfHref && (
        <p>
          <a href={pdfHref} download>
            {t("resume.downloadPdf")}
          </a>
        </p>
      )}
      <ResumeDocument lang={lang} data={resume} />
    </>
  ) : (
    <>
      <h1>{t("nav.resume")}</h1>
      <p>{t("resume.unavailable")}</p>
    </>
  )}
</BaseLayout>
