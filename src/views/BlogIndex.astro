---
/**
 * The blog index for one locale.
 *
 * Both locale pages render this, so English and Spanish cannot drift apart. Posts with no
 * counterpart in this locale are simply absent — the language switcher handles that by falling back
 * to the section index rather than dead-ending.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/entries/PostCard.astro";
import { getEntries, type AnyEntry } from "../lib/content";
import type { Locale } from "../i18n/routes";
import { useTranslations } from "../i18n/utils";
import { getSite } from "../lib/content";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const site = await getSite(lang);
const posts = (await getEntries("blog", lang)) as AnyEntry[];
---

<BaseLayout
  title={t("nav.blog")}
  description={site.profile.summary}
  route={{ key: "blog" }}
>
  <h1>{t("nav.blog")}</h1>
  <p>{t("list.count", { n: posts.length })}</p>

  <ul>
    {posts.map((post) => (
      <li>
        <PostCard entry={post} lang={lang} />
      </li>
    ))}
  </ul>
</BaseLayout>
