# The committed template. It documents the schema and holds no values.
#
# `.gitignore` excludes `.env` and `.env.*` and then re-includes this one file, so copying it to
# `.env` and filling it in cannot leak: the copy is ignored.
#
#     cp .env.example .env
#
# Every variable here is OPTIONAL, and unset is a supported state rather than a misconfiguration.
# The schema that validates them lives in `astro.config.mjs` under `env.schema`; a name that does not
# appear there is a build error, which is the point.
#
# All three are PUBLIC and are inlined into the client bundle. Nothing secret belongs in this file.

# Where the contact form POSTs. Must be an absolute URL.
# Unset → the form ships visibly disabled with a notice, instead of silently POSTing nowhere.
# Choosing the endpoint is production engineering and sits outside the Grove APIs.
PUBLIC_CONTACT_ENDPOINT=

# The address the unwired notice offers as the way to send word instead.
# Unset → the notice points at the trail signs (the social links) rather than inventing an address.
PUBLIC_CONTACT_EMAIL=

# A published résumé PDF, as a path or URL.
# Unset → no download link renders. A link to a PDF that does not exist is worse than no link.
PUBLIC_RESUME_PDF=
